{
  "type": "object",
  "properties": {
    "DryRun": {
      "type": "boolean"
    },
    "ValidateDisabledStages": {
      "type": "boolean",
      "description": "Should disable stages be validated"
    },
    "GitData": {
      "description": "Data passed down from GitHub Actions. This is all assumed to be set in env. Unprocessed",
      "type": "object",
      "properties": {
        "AuthToken": {
          "type": "string"
        },
        "Repository": {
          "type": "string"
        },
        "HeadRef": {
          "type": "string"
        },
        "PrNumber": {
          "type": "string"
        },
        "PrTitle": {
          "type": "string"
        },
        "PrDescription": {
          "type": "string"
        }
      }
    },
    "VersionBump": {
      "description": "A stage that allows you to bump the AssemblyVersion in a .csproj file",
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "Commit": {
          "type": "boolean",
          "description": "Should this stage create a seperate commit"
        },
        "ComponentToBump": {
          "$ref": "#/$defs/versionComponent",
          "enum": [
            "Major",
            "Minor",
            "Build",
            "Revision"
          ],
          "description": "Which part of the version should be bumped"
        },
        "ResetSmallerComponents": {
          "type": "boolean",
          "description": "Should parts of the version smaller than \u003Csee cref=\u0022P:Kavita.ReleaseTools.Stages.VersionBump.VersionBumpConfiguration.ComponentToBump\u0022 /\u003E be reinit to 0"
        },
        "CsprojPath": {
          "type": "string",
          "description": "Path the to .csproj file that contains the version to bump"
        },
        "CommitMessage": {
          "type": [
            "null",
            "string"
          ],
          "description": "Custom commit message. Only relevant if \u003Csee cref=\u0022P:Kavita.ReleaseTools.Stages.VersionBump.VersionBumpConfiguration.Commit\u0022 /\u003E is true"
        }
      },
      "required": [
        "Disabled",
        "ComponentToBump",
        "CsprojPath"
      ]
    },
    "GenerateOpenApi": {
      "description": "A stage that allows for the generation of the opanapi spec (swagger)",
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "CsprojPath": {
          "type": "string",
          "description": "Path to the project that produces the assembly the spec is generated from"
        },
        "SwashbuckleVersionSource": {
          "type": "string",
          "description": "Path to a .csproj referencing Swashbuckle.AspNetCore, which the swagger CLI version is read from"
        },
        "OutputPath": {
          "type": "string",
          "description": "Where the generated spec is written"
        },
        "DocumentName": {
          "type": "string",
          "description": "Swagger document name to generate"
        },
        "Configuration": {
          "type": "string"
        },
        "Commit": {
          "type": "boolean",
          "description": "Commit the generated spec, when it differs from the one already in the repository"
        },
        "CommitMessage": {
          "type": [
            "null",
            "string"
          ],
          "description": "Custom commit message. Only relevant if \u003Csee cref=\u0022P:Kavita.ReleaseTools.Stages.GenerateOpenApi.GenerateOpenApiConfiguration.Commit\u0022 /\u003E is true"
        }
      },
      "required": [
        "CsprojPath",
        "SwashbuckleVersionSource"
      ]
    },
    "FlushGitChanges": {
      "description": "A stage that allows any changes to be commit in one go.",
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "Branch": {
          "type": "string",
          "description": "Branch to commit the changes to"
        },
        "CommitMessage": {
          "type": [
            "null",
            "string"
          ],
          "description": "A custom commit message"
        },
        "Files": {
          "$ref": "#/$defs/listOfString",
          "description": "Which files should be tracked"
        }
      },
      "required": [
        "Files"
      ]
    },
    "BuildFrontend": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "Path": {
          "type": "string",
          "description": "Working directory. (Where package.json is located)"
        },
        "BuildScript": {
          "type": "string",
          "description": "Which script to run to build the frontend"
        },
        "OutputPath": {
          "type": "string",
          "description": "Path relative to \u003Csee cref=\u0022P:Kavita.ReleaseTools.Stages.BuildFrontend.BuildFrontendConfiguration.Path\u0022 /\u003E where the frontend is created"
        },
        "CopyTo": {
          "type": "string"
        },
        "FullReplace": {
          "type": "boolean",
          "description": "When true, deletes the destination directory before copying.\nWhen false (default), merges the output into the destination,\noverwriting files that already exist."
        },
        "AllowLegacyPeerDeps": {
          "type": "boolean",
          "description": "Should legacy peer dep be enabled when installing dependencies"
        }
      },
      "required": [
        "Path",
        "BuildScript",
        "OutputPath",
        "CopyTo"
      ]
    },
    "BuildServer": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "AppName": {
          "type": "string",
          "description": "Your application name (used for tar files)"
        },
        "SlnPath": {
          "type": "string",
          "description": "Path to the solution file"
        },
        "CsprojPath": {
          "type": "string",
          "description": "Path to the project to build"
        },
        "Rids": {
          "$ref": "#/$defs/listOfString",
          "description": "For which Runtime Identifiers should be packaged"
        },
        "Configuration": {
          "type": "string",
          "description": "Which configuration to build against; Defaults to Release"
        },
        "SelfContained": {
          "type": "boolean",
          "description": "Build self contained"
        },
        "OutputPath": {
          "type": "string",
          "description": "Where should the tar balls be stored"
        },
        "RenameFiles": {
          "$ref": "#/$defs/listOfFromTo",
          "description": "Rename files inside the output path"
        },
        "CopyFiles": {
          "$ref": "#/$defs/listOfFromTo",
          "description": "Copy files from the git repository in the output paths (relative paths)"
        },
        "DeletePaths": {
          "$ref": "#/$defs/listOfString",
          "description": "Deletes files in the output path"
        }
      },
      "required": [
        "SlnPath",
        "CsprojPath",
        "Rids"
      ]
    },
    "BuildLibrary": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "CsprojPath": {
          "type": "string",
          "description": "Path to the project file"
        },
        "Configuration": {
          "type": "string",
          "description": "Which configuration to build against, defaults to Release"
        },
        "OutputDirectory": {
          "type": "string",
          "description": "Where should the nupkg be generated to"
        }
      },
      "required": [
        "CsprojPath",
        "Configuration",
        "OutputDirectory"
      ]
    },
    "PublishToNuGet": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "ApiKey": {
          "type": "string",
          "description": "Your NuGet ApiKey. Do not store this in Git. Prefer the NUGET_API_KEY env var"
        },
        "OutputDirectory": {
          "type": "string",
          "description": "Where our the nupkg files located"
        },
        "Source": {
          "type": "string",
          "description": "NuGet source"
        },
        "SkipDuplicate": {
          "type": "boolean",
          "description": "Skip duplicate version, defaults to true"
        }
      },
      "required": [
        "OutputDirectory",
        "Source"
      ]
    },
    "NotifyDiscord": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "WebhookUrl": {
          "type": [
            "null",
            "string"
          ],
          "description": "Webhook the release notification is posted to. Comes from the \u003Cc\u003EDISCORD_WEBHOOK\u003C/c\u003E\nenvironment variable, so the webhook doesn\u0027t have to be committed."
        },
        "Message": {
          "type": "string",
          "description": "Message"
        },
        "Username": {
          "type": "string",
          "description": "Username"
        },
        "Icon": {
          "type": "string",
          "format": "uri",
          "description": "Icon"
        }
      },
      "required": [
        "Username",
        "Icon"
      ]
    },
    "Docker": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "Push": {
          "type": "boolean",
          "description": "Push images upstream"
        },
        "Load": {
          "type": "boolean",
          "description": "Load into local docker registry"
        },
        "Context": {
          "type": "string",
          "description": "Docker context"
        },
        "File": {
          "type": "string",
          "description": "Docker file"
        },
        "Platforms": {
          "$ref": "#/$defs/listOfString",
          "description": "For which platforms to build"
        },
        "Tags": {
          "description": "Image tags. You may use the placeholder {Version} to insert the current version",
          "type": "object",
          "propertyNames": {
            "enum": [
              "Stable",
              "Nightly",
              "Canary"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/listOfString"
          }
        },
        "Images": {
          "$ref": "#/$defs/listOfString",
          "description": "Image names (Becomes a Matrix with \u003Csee cref=\u0022P:Kavita.ReleaseTools.Stages.Docker.DockerConfiguration.Tags\u0022 /\u003E)"
        },
        "LogLevel": {
          "$ref": "#/$defs/logLevel",
          "enum": [
            "Trace",
            "Debug",
            "Information",
            "Warning",
            "Error",
            "Critical",
            "None"
          ],
          "description": "LogLevel of the docker build command"
        }
      }
    },
    "ParseReleaseTypes": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "Disabled": {
          "type": "boolean"
        },
        "ReleaseTypes": {
          "$ref": "#/$defs/listOfReleaseType"
        },
        "BranchRequirements": {
          "description": "Requierments per relase",
          "type": "object",
          "propertyNames": {
            "enum": [
              "Stable",
              "Nightly",
              "Canary"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "StartWiths": {
                "type": "string",
                "description": "The branch has to start with"
              },
              "DoesNotContain": {
                "type": "string",
                "description": "The branch cannot contain"
              }
            },
            "required": [
              "StartWiths",
              "DoesNotContain"
            ]
          }
        }
      },
      "required": [
        "BranchRequirements"
      ]
    }
  },
  "required": [
    "GitData"
  ],
  "$defs": {
    "listOfReleaseType": {
      "type": "array",
      "items": {
        "enum": [
          "Stable",
          "Nightly",
          "Canary"
        ]
      }
    },
    "versionComponent": {
      "enum": [
        "Major",
        "Minor",
        "Build",
        "Revision"
      ]
    },
    "listOfString": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listOfFromTo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "From": {
            "type": "string"
          },
          "To": {
            "type": "string"
          }
        },
        "required": [
          "From",
          "To"
        ]
      }
    },
    "logLevel": {
      "enum": [
        "Trace",
        "Debug",
        "Information",
        "Warning",
        "Error",
        "Critical",
        "None"
      ]
    }
  }
}